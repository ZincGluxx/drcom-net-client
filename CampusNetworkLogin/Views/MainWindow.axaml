<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="450"
        Width="560" Height="435"
        MinWidth="540" MinHeight="420"
        x:Class="CampusNetworkLogin.Views.MainWindow"
        Icon="avares://DrcomNET/Resources/icon.ico"
        Title="校园网登录"
        WindowStartupLocation="CenterScreen"
        Background="#EEF3F8"
        ExtendClientAreaToDecorationsHint="False"
        CanResize="False"
        FontFamily="system-ui, 'Microsoft YaHei UI', 'Microsoft YaHei', 'Segoe UI', sans-serif"
        Opacity="0">

    <Window.Transitions>
        <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="LinearEasing"/>
        </Transitions>
    </Window.Transitions>

    <Window.Styles>
        <Style Selector="TextBlock.title">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.metric">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="Border.surface">
            <Setter Property="Background" Value="#FEFEFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BoxShadow" Value="0 8 24 0 #12000000"/>
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.primarybtn">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.dangerbtn">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.secondarybtn">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>
    </Window.Styles>

    <Panel Background="#EEF3F8">
        <Grid RowDefinitions="38,Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="14,0" PointerPressed="TitleBar_PointerPressed">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="21" Height="21" CornerRadius="5" Background="#2563EB">
                        <TextBlock Text="D" Foreground="White" FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Drcom NET" Classes="title" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusIndicator" Text="● 未连接"
                               FontWeight="SemiBold" Foreground="#FF453A" FontSize="12"/>
                </Border>
            </Grid>

            <!-- 登录步骤指示器 -->
            <Border x:Name="StepIndicatorBorder" Grid.Row="1" IsVisible="False"
                    Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="8" Padding="12,6" Margin="14,2,14,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                    <Border x:Name="Step1Dot" Width="10" Height="10" CornerRadius="5" Background="#CBD5E1"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="Step1Text" Text="挑战获取" FontSize="11" Foreground="#94A3B8"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="→" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="2,0"/>
                    <Border x:Name="Step2Dot" Width="10" Height="10" CornerRadius="5" Background="#CBD5E1"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="Step2Text" Text="身份认证" FontSize="11" Foreground="#94A3B8"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="→" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="2,0"/>
                    <Border x:Name="Step3Dot" Width="10" Height="10" CornerRadius="5" Background="#CBD5E1"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="Step3Text" Text="保活建立" FontSize="11" Foreground="#94A3B8"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="250,*" ColumnSpacing="10" Margin="14,6,14,10">
                <Border Grid.Column="0" Classes="surface" Padding="12">
                    <Grid RowDefinitions="Auto,8,Auto,8,Auto,*,Auto">
                        <TextBlock Grid.Row="0" Text="登录" Classes="sectionTitle"/>

                        <StackPanel Grid.Row="2" Spacing="6">
                            <TextBox x:Name="UsernameField" PlaceholderText="校园网账号"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBox x:Name="PasswordField" PasswordChar="●"
                                         PlaceholderText="密码"/>
                                <Button Grid.Column="1" x:Name="TogglePasswordBtn" Content="显示"
                                        Width="44" Height="34" FontSize="11" CornerRadius="6"
                                        BorderBrush="#CBD5E1" BorderThickness="1" Background="#FFF"
                                        Foreground="#64748B" Click="TogglePasswordBtn_Click"/>
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Row="4" ColumnDefinitions="*,8,*">
                            <Button Grid.Column="0" x:Name="LoginBtn" Content="登录" Classes="primarybtn"
                                    Click="LoginBtn_Click"/>
                            <Button Grid.Column="0" x:Name="LogoutBtn" Content="下线" Classes="dangerbtn"
                                    Click="LogoutBtn_Click" IsVisible="False"/>
                            <Button Grid.Column="2" x:Name="SaveBtn" Content="保存" Classes="secondarybtn"
                                    Click="SaveBtn_Click"/>
                        </Grid>

                        <StackPanel Grid.Row="5" Spacing="6" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="自动登录" Classes="caption" VerticalAlignment="Center"/>
                                <ToggleSwitch Grid.Column="1" x:Name="AutoLoginCheck"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="开机自启" Classes="caption" VerticalAlignment="Center"/>
                                <ToggleSwitch Grid.Column="1" x:Name="AutoStartCheck"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="关闭到托盘" Classes="caption" VerticalAlignment="Center"/>
                                <ToggleSwitch Grid.Column="1" x:Name="MinimizeToTrayCheck"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="6" x:Name="ConfigStatusText" Text="待检查"
                                   Classes="caption"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Spacing="8">
                    <Border Classes="panel" Padding="10">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="连接检测" Classes="sectionTitle"/>
                                <TextBlock Grid.Column="1" x:Name="KeepAliveStatusText" Text="保活未启动"
                                           Classes="caption"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,8,*">
                                <Button Grid.Column="0" x:Name="PingInternalBtn" Content="内网"
                                        Classes="secondarybtn" Click="PingInternalBtn_Click"/>
                                <Button Grid.Column="2" x:Name="PingExternalBtn" Content="外网"
                                        Classes="secondarybtn" Click="PingExternalBtn_Click"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,8,*">
                                <StackPanel>
                                    <TextBlock Text="jlu.edu.cn" Classes="caption"/>
                                    <TextBlock x:Name="InternalStatusText" Text="未检测" Classes="metric"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="www.baidu.com" Classes="caption"/>
                                    <TextBlock x:Name="ExternalStatusText" Text="未检测" Classes="metric"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="ConnectionDurationText" Text="" Classes="caption"
                                       IsVisible="False" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="panel" Padding="10">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="本机网络" Classes="sectionTitle"/>
                                <Button Grid.Column="1" x:Name="RefreshNetworkBtn" Content="刷新"
                                        Classes="secondarybtn" Width="58"
                                        Click="RefreshNetworkBtn_Click"/>
                            </Grid>
                            <TextBlock x:Name="AdapterStatusText" Text="网卡: --" Classes="metric"/>
                            <Grid ColumnDefinitions="*,8,*">
                                <TextBlock x:Name="IpStatusText" Text="IP: --" Classes="metric"/>
                                <TextBlock Grid.Column="2" x:Name="GatewayStatusText" Text="网关: --" Classes="metric"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,8,*">
                                <TextBlock x:Name="DnsStatusText" Text="DNS: --" Classes="metric"/>
                                <TextBlock Grid.Column="2" x:Name="MacStatusText" Text="MAC: --" Classes="metric"/>
                            </Grid>
                            <Button x:Name="EditNetworkBtn" Content="设置静态 IP / 网关 / DNS"
                                    Classes="secondarybtn" HorizontalAlignment="Stretch"
                                    Click="EditNetworkBtn_Click"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="StatusHintText" Text="认证服务器已内置"
                               Classes="caption" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Panel>
</Window>
