<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="440"
        Width="320" Height="440"
        MinWidth="280" MinHeight="400"
        x:Class="CampusNetworkLogin.Views.MainWindow"
        Icon="avares://Drcom NET/Resources/icon.ico"
        Title="校园网登录"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        CanResize="False"
        Opacity="0">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.winbtn">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.primarybtn">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.tab">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>
        <Style Selector="Button.tab.tab-active">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="Foreground" Value="#2563EB"/>
        </Style>
        <Style Selector="Button.smallbtn">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Styles>

    <Border Background="#F4F6F8" CornerRadius="12" ClipToBounds="True"
            BorderBrush="#E2E8F0" BorderThickness="1">
        <Grid RowDefinitions="40,*">
            <Border Grid.Row="0" x:Name="TitleBar"
                    Background="White"
                    CornerRadius="12,12,0,0"
                    BorderThickness="0,0,0,1" BorderBrush="#E8ECF0"
                    PointerPressed="TitleBar_PointerPressed">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="校园网登录" FontSize="12" FontWeight="SemiBold"
                               Foreground="#1E293B" VerticalAlignment="Center" Margin="14,0,0,0"
                               IsHitTestVisible="False"/>
                    <Panel Grid.Column="1" IsHitTestVisible="False"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0"
                                VerticalAlignment="Center" Spacing="4">
                        <Button x:Name="MinBtn" Content="─" Classes="winbtn"
                                Background="#F1F5F9" Foreground="#475569" Click="MinBtn_Click"/>
                        <Button x:Name="CloseBtn" Content="✕" Classes="winbtn"
                                Background="#FEE2E2" Foreground="#EF4444" Click="CloseBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="12,10,12,12" RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="2"
                            HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Button x:Name="TabLogin" Content="登录" Classes="tab tab-active" Click="TabLogin_Click"/>
                    <Button x:Name="TabConfig" Content="配置" Classes="tab" Click="TabConfig_Click"/>
                    <Button x:Name="TabLog" Content="日志" Classes="tab" Click="TabLog_Click"/>
                </StackPanel>

                <ContentControl x:Name="PageHost" Grid.Row="1">
                    <Grid x:Name="PageLogin" RowDefinitions="Auto,Auto,*,Auto">
                        <TextBox Grid.Row="0" x:Name="UsernameField" Watermark="校园网邮箱" Height="38"/>
                        <Panel Grid.Row="1" Margin="0,10,0,0">
                            <Button x:Name="LoginBtn" Content="登 录" Classes="primarybtn"
                                    Background="#3B82F6" Foreground="White" Click="LoginBtn_Click"/>
                            <Button x:Name="LogoutBtn" Content="下 线" Classes="primarybtn"
                                    Background="#EF4444" Foreground="White"
                                    Click="LogoutBtn_Click" IsVisible="False"/>
                        </Panel>
                        <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="10" Padding="12"
                                VerticalAlignment="Bottom">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="StatusIndicator" Text="● 未连接"
                                           FontWeight="SemiBold" Foreground="#EF4444" FontSize="12"/>
                                <TextBlock x:Name="IpStatusText" Text="IP: --" Foreground="#64748B" FontSize="11"/>
                                <TextBlock x:Name="MacStatusText" Text="MAC: --" Foreground="#64748B" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ContentControl>
            </Grid>
        </Grid>
    </Border>
</Window>
