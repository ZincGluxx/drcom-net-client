<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CampusNetworkLogin.Views.ConfigPageView">
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Text="邮箱" Foreground="#475569" FontSize="11" FontWeight="SemiBold"/>
                    <TextBox x:Name="ConfigUsernameField" Watermark="输入邮箱" Height="36"/>
                </StackPanel>
                <StackPanel Spacing="3">
                    <TextBlock Text="密码" Foreground="#475569" FontSize="11" FontWeight="SemiBold"/>
                    <TextBox x:Name="PasswordField" PasswordChar="●" Height="36"/>
                </StackPanel>
                <StackPanel Spacing="3">
                    <TextBlock Text="服务器" Foreground="#475569" FontSize="11" FontWeight="SemiBold"/>
                    <TextBox x:Name="ServerField" Text="10.100.61.3" Height="36"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,10,0,0">
            <CheckBox x:Name="AutoLoginCheck" Content="自动登录" Foreground="#475569" FontSize="12"/>
            <CheckBox x:Name="AutoStartCheck" Content="开机自启" Foreground="#475569" FontSize="12"/>
            <Button x:Name="SaveBtn" Content="保存" Classes="smallbtn"
                    Background="#10B981" Foreground="White" Margin="0,6,0,0"
                    Click="SaveBtn_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
