<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
      <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
      <Nullable>enable</Nullable>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
      <AssemblyName>DrcomNET</AssemblyName>
      <RootNamespace>CampusNetworkLogin</RootNamespace>
    <Version>1.0.5.0</Version>
      <Description>Drcom .NET for JLU - 校园网登录客户端</Description>

    <!-- NativeAOT -->
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
      <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
    <OptimizationPreference>Size</OptimizationPreference>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <AvaloniaNameAttributeIsGenerated>true</AvaloniaNameAttributeIsGenerated>
    </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources\icon.ico" />
  </ItemGroup>

    <ItemGroup>
    <None Include="Resources\icon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

